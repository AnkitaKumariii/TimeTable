# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: leave as-is (SQLite file)
DATABASE_URL=sqlite:///./nitaTime.db

# Production (Turso): replace with your Turso DB URL
# DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Admin Seed ────────────────────────────────────────────────────────────────
# These are used ONLY on first run to seed the admin user.
# Change password immediately after first login in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# CORS_ORIGINS=https://your-app.pages.dev,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
